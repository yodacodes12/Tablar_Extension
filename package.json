{
  "name": "tablar",
  "description": "Privacy-first tab manager that suspends inactive tabs using the browser's native discard.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "npm run build:chrome && npm run build:edge && npm run build:brave && npm run build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:brave": "wxt build -b brave",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:e2e": "TABLAR_E2E=1 wxt build -b chrome",
    "zip": "wxt zip -b chrome && wxt zip -b edge && wxt zip -b brave && wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:chrome && npm run build:e2e && playwright test",
    "postinstall": "wxt prepare",
    "build:e2e:firefox": "TABLAR_E2E=1 wxt build -b firefox --mv3",
    "test:e2e:firefox": "npm run build:e2e:firefox && .venv-e2e/bin/python tests/e2e-firefox/run.py",
    "check": "npm run compile && npm run lint && npm run test && npm run build && npm run lint:firefox"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
